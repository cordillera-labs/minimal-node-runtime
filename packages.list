# Debian packages whose files ship in the image, one per line, with the reason.
# The image carries a dpkg status entry for exactly this set, so a scanner sees
# every package whose files ship. Every Node.js line ships this same set, and the
# build fails if a line's node links anything else. Adding or removing an entry
# is a breaking change: each line's next build publishes to its <line>-candidate
# channel only.
base-files       # /etc/debian_version and /etc/os-release, which scanners use to detect the OS; the common licence texts
ca-certificates  # the Mozilla CA bundle at /etc/ssl/certs/ca-certificates.crt
gcc-14-base      # the copyright file that libgcc-s1 and libstdc++6 point their /usr/share/doc entries to
libc6            # every shared library of the package: the dynamic loader, libc, libm, libresolv, the nss libraries and the rest; node links five of them and native addons need the others
libgcc-s1        # libgcc_s.so.1, its only shared library
libstdc++6       # libstdc++.so.6, its only shared library
