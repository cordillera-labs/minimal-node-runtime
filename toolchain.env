# Build and scan tool pins, shared by the scripts and the workflows.
# The BuildKit version fixes the layer compression and the tar layout, so a
# change here changes image digests. Change it only on its own, and expect the
# next update run to publish a new digest for the same inputs.
BUILDX_VERSION=v0.37.2
BUILDKIT_IMAGE=moby/buildkit:v0.33.1@sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea
TRIVY_VERSION=v0.74.0
COSIGN_IMAGE=gcr.io/projectsigstore/cosign:v2.6.1@sha256:68839b7f13dac5a6744a5d8818e984dd39183374e37855c19e14d623d9bc9037
IMAGE_REPOSITORY=ghcr.io/cordillera-labs/minimal-node-runtime
