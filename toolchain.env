# Build and scan tool pins, shared by the scripts and the workflows.
# This file is part of the build definition hash (scripts/lock.py), so any
# change here makes the next update run rebuild. The BuildKit version fixes the
# layer compression and the tar layout, so a BuildKit or buildx change can
# change the image digest, and the run then publishes a new digest for the same
# inputs. A change to the other pins rebuilds to the same digest, which
# publishes nothing new. Change the BuildKit pins only on their own.
BUILDX_VERSION=v0.37.2
BUILDKIT_IMAGE=moby/buildkit:v0.34.2@sha256:c5f8862f52499773af85bc07695b2379ef08e8002352b0df2c4864c91d78dabe
TRIVY_VERSION=v0.74.0
COSIGN_IMAGE=gcr.io/projectsigstore/cosign:v2.6.1@sha256:68839b7f13dac5a6744a5d8818e984dd39183374e37855c19e14d623d9bc9037
IMAGE_REPOSITORY=ghcr.io/cordillera-labs/minimal-node-runtime
